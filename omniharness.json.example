{
  "model": {
    "modelAdapter": "openai",
    "baseUrl": "https://api.openai.com/v1",
    "apiKey": "YOUR_API_KEY_HERE",
    "model": "gpt-4o-mini"
  },
  "storage": {
    "storageAdapter": "jsonl",
    "storageDir": ".omniharness/sessions"
  },
  "approval": {
    "approval": "rules",
    "escalation": "ask"
  },
  "sandbox": {
    "sandbox": "policy",
    "elevatedSandbox": "policy"
  },
  "agent": {
    "maxSteps": 0
  },
  "memory": {
    "longTermMemoryEncryption": false,
    "longTermMemoryKeyFile": ".omniharness/memory.key"
  },
  "tools": {
    "limits": {
      "http": { "headersTimeoutMs": 30000 },
      "preview": { "maxConnections": 64 }
    }
  },
  "mcp": {
    "mcpServers": {}
  },
  "skills": {
    "skills": [
      {
        "name": "repo-conventions",
        "description": "本仓库的编码约定（受种后在相关会话自动注入）",
        "instructions": "改代码前先读 AGENTS.md；提交信息用「类型(范围): 摘要」；测试与实现同批提交。",
        "tags": ["约定", "提交"]
      }
    ]
  }
}
