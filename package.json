{
  "name": "@omniharness/app",
  "version": "0.6.0-alpha.2",
  "private": true,
  "description": "OmniHarness 独立应用：React 工作台（web/）+ Electron 桌面端（desktop/）+ 后端宿主（src/）",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "defaults",
    "examples",
    "CHANGELOG.md"
  ],
  "bin": {
    "omniharness": "dist/src/apps/cli/exec.js"
  },
  "scripts": {
    "build": "node scripts/buildDist.mjs",
    "build:web": "vite build",
    "clean": "node scripts/cleanDist.mjs dist web/dist",
    "dev": "node scripts/devAll.mjs",
    "start": "node scripts/startAll.mjs",
    "serve": "node dist/src/apps/cli/exec.js serve",
    "example:embed": "node examples/embed-demo.mjs",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:watch": "vite build --watch",
    "web:test": "vitest run",
    "web:test:watch": "vitest",
    "typecheck": "npm run typecheck:backend && npm run typecheck:web && npm run typecheck:desktop",
    "typecheck:backend": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "typecheck:desktop": "tsc -p desktop/tsconfig.json --noEmit",
    "kernel:check": "node scripts/checkKernelBoundary.mjs",
    "kernel:surface": "node scripts/kernelSurface.mjs",
    "kernel:vendor": "node scripts/vendorKernel.mjs",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:start": "npm --prefix desktop start",
    "desktop:test": "npm --prefix desktop test",
    "desktop:smoke": "npm --prefix desktop run smoke",
    "desktop:stage": "npm --prefix desktop run stage",
    "desktop:dist": "npm --prefix desktop run dist",
    "test": "npm run web:test",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run kernel:check && npm run typecheck && npm run web:test && npm run build && npm run build:web && npm run smoke && npm run desktop:build && npm run desktop:test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@omniharness/kernel": "file:vendor/omniharness-kernel-0.1.0-alpha.12.tgz",
    "antd": "6.6.8",
    "croner": "10.0.1",
    "highlight.js": "^11.12.0",
    "jose": "6.2.12",
    "katex": "^0.16.47",
    "markdown-it": "^14.3.3",
    "openid-client": "^6.8.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sirv": "^3.0.2",
    "zod": "^4.6.4"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.4",
    "unpdf": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.4.4",
    "vitest": "^2.1.9"
  }
}
